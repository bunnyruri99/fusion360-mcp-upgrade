# ============================================================
# Fusion 360 MCP Bridge — ortam değişkenleri şeması
# Gerçek değerleri .env dosyasına kopyalayın (asla commit etmeyin)
# ============================================================

# --- Fusion TCP Bridge ---
FUSION_HOST=127.0.0.1          # Add-in TCP adresi (localhost dışına açmayın)
FUSION_PORT=9876               # TCP port
FUSION_TIMEOUT=30.0            # Operasyon başına maksimum süre (saniye)

# --- Autodesk Platform Services / Forge (Faz 3+) ---
# Yalnızca forge_consent=True ile kullanılır (KVKK double-opt-in)
APS_CLIENT_ID=                 # Forge OAuth2 client ID
APS_CLIENT_SECRET=             # Forge OAuth2 client secret
APS_FORGE_CONSENT=0            # 1 = Forge backend aktif, 0 = devre dışı (varsayılan)

# --- FreeCAD Backend (Faz 3+) ---
FREECAD_CMD=                   # FreeCAD yürütülebilir dosyasının tam yolu
                               # Örnek Windows: C:\Program Files\FreeCAD\bin\FreeCAD.exe
                               # Örnek macOS:   /Applications/FreeCAD.app/Contents/MacOS/FreeCAD

# --- Export ---
DEFAULT_EXPORT_DIR=./exports   # Batch export için varsayılan dizin
